# SteelDraw AI Extractor — environment template
# Copy to .env in the project root (and optionally backend/.env):
#   cp .env.example .env
#
# Then paste your OpenAI key:
#   OPENAI_API_KEY=sk-...
#
# Restart backend after editing. The terminal will print:
#   [AI extract] RAW RESPONSE ...
#   [AI summary] RAW RESPONSE ...

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
