# SteelDraw AI Extractor — environment template
# Copy to the PROJECT ROOT (same folder as README.md):
#   Windows CMD:        copy .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# Prefer Gemini (Google AI Studio key). OpenAI is a fallback.
#
# Paste keys on ONE line each (no quotes, no spaces around =):
#   GEMINI_API_KEY=AIza...
#   OPENAI_API_KEY=sk-proj-...
#
# You can also put the same lines in backend/.env.
# An empty KEY= in either file is ignored if the other has a real key.
#
# After saving, restart uvicorn. You should see:
#   [startup] AI READY — provider=gemini model=gemini-2.0-flash
# Check: http://127.0.0.1:8000/api/health  →  "ai_configured": true

# --- Preferred: Google Gemini (vision — reads bay dims from the drawing image) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional fallback: OpenAI (use a vision model, e.g. gpt-4o) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
