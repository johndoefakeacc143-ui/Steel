# Optional — OCR/regex extraction works without an API key.
# Set these only if you later enable vision-LLM assist.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Tesseract binary path (leave blank if tesseract is on PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# OCR render DPI for scanned PDF pages
OCR_DPI=250
