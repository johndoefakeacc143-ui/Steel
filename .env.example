# SteelDraw AI Extractor — environment template
# Copy to the PROJECT ROOT (same folder as README.md):
#   cp .env.example .env
#
# Then paste your real key on ONE line (no quotes, no spaces):
#   OPENAI_API_KEY=sk-proj-xxxxxxxx
#
# You can also put the same line in backend/.env.
# An empty OPENAI_API_KEY= in either file is ignored if the other has a real key.
#
# After saving, restart uvicorn. You should see:
#   [startup] OpenAI READY — key sk-proj-…
# and later:
#   [AI extract] RAW RESPONSE ...
#   [AI summary] RAW RESPONSE ...
#
# Check: http://127.0.0.1:8000/api/health  →  "openai_configured": true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
