# Optional vision assist — reads each uploaded drawing like a human detailer.
# OCR always runs. Vision fills gaps when a key is set (per upload, never hardcoded).
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-flash

# Tesseract (leave blank if on PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# High-capacity OCR (each upload is scanned fresh)
OCR_DPI=320
OCR_UPSCALE=1.5
OCR_TILE_SIZE=2200
OCR_TILE_OVERLAP=280
OCR_MIN_CONF=10
OCR_PSMS=11,6,4
# Fraction of page width/height to keep (drop only outer title strip)
OCR_CROP_RIGHT=0.92
OCR_CROP_BOTTOM=0.95
