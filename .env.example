# Vision assist — Google Gemini (free tier from Google AI Studio)
# 1) Open https://aistudio.google.com/apikey
# 2) Create API key (free)
# 3) Paste below (no quotes, no spaces around =)
# 4) Restart the server
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional alternative (paid / trial): OpenAI
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# High-capacity OCR (always on; works without any API key)
OCR_DPI=320
OCR_UPSCALE=1.5
OCR_TILE_SIZE=2200
OCR_TILE_OVERLAP=280
OCR_MIN_CONF=10
OCR_PSMS=11,6,4
OCR_CROP_RIGHT=0.92
OCR_CROP_BOTTOM=0.95
