# 1) Get a free API key: https://aistudio.google.com/apikey
# 2) Copy this file to .env in the project root:
#      cp .env.example .env
# 3) Replace the value below with your real key (no quotes needed):
# 4) Restart the server: uvicorn backend:app --host 0.0.0.0 --port 8000 --reload
#
# Or export in the shell instead of using .env:
#   export GEMINI_API_KEY="your_api_key_here"

GEMINI_API_KEY=your_google_gemini_api_key_here
