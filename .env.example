# Copy to .env and fill in your key:
#   cp .env.example .env

# Required for AI enrichment (LangChain + OpenAI).
# Regex extraction still works without a key.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Frontend (optional) — leave empty to use Vite proxy to localhost:8000
# VITE_API_URL=http://127.0.0.1:8000
